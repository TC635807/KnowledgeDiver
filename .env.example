# =============================================================================
# KnowledgeDiver 环境变量配置模板
# 复制此文件为 .env 并填入真实值后，程序自动加载
# =============================================================================

# ── AI 服务 (OpenAI 兼容) ───────────────────────────────────────────────────
AI_API_URL=https://opencode.ai/zen/go/v1/responses
AI_API_KEY=your_api_key_here
AI_MODEL=deepseek-v4-flash
AI_CONCURRENCY=2
PROXY_PORT=0
# Agent 思考强度（deepseek-v4-flash 支持 low/high/max；思考模式开启时 temperature 不生效）
AGENT_REASONING_EFFORT=high

# ── 搜索服务 ────────────────────────────────────────────────────────────────
# 默认提供商：free（免费多引擎，无需任何 key）| bocha | baidu | exa
DEFAULT_SEARCH_PROVIDER=free

# 免费多引擎搜索（provider=free）：引擎优先级从左到右，任一成功即止
# 可选：bing | anysearch | exa-mcp | ddg | ddg-lite | searxng
# 国内网络实测 bing/anysearch/exa-mcp 可用，ddg/searxng 不通；海外可把它们排前面
FREE_SEARCH_ENGINES=bing,anysearch,exa-mcp,ddg,searxng
FREE_SEARCH_TIMEOUT=15
FREE_SEARCH_CONCURRENCY=5
FREE_SEARCH_RATE_LIMIT=1.0
FREE_SEARCH_POOL_SIZE=20
FREE_SEARCH_BING_PAGES=1
BING_MARKET=zh-CN
# AnySearch 可选 key（仅用于提高匿名额度；留空即为匿名免费额度）
# ANYSEARCH_API_KEY=
# 自建 SearXNG 实例（逗号分隔，需开启 format=json）
# SEARXNG_INSTANCES=https://your-searxng.example

# 博查 (Bocha) Web Search —— 仅在 DEFAULT_SEARCH_PROVIDER=bocha 时需要
# BOCHA_API_URL=https://api.bocha.cn/v1/web-search
# BOCHA_API_KEY=your_bocha_api_key_here
# BOCHA_CONCURRENCY=5
# 博查失效时自动切百度反代（仅对 bocha 生效）
# SEARCH_AUTO_FALLBACK=1

# ── JWT 认证 ────────────────────────────────────────────────────────────────
# 生产环境务必更换为随机长字符串: openssl rand -hex 32
# 缺失时代码会随机生成一个并告警（仅本次进程有效，重启后本地 token 失效）；
# ./start.sh 首次启动会自动写入随机值。
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION_HOURS=24

# ── 内置本地账号（客户端独有）────────────────────────────────────────────────
# 开机自动为内置账号签发本地 JWT，无需任何登录动作即可进入工作区；
# 该账号同时是本地数据命名空间（cards/local/）。
LOCAL_ACCOUNT=1
LOCAL_ACCOUNT_USER=local

# ── 官方服务器接入（客户端独有）──────────────────────────────────────────────
# 留空 = 整个反向代理不启用（纯本地模式，行为与不接入云端完全一致）。
# 身份 / 论坛 / 迁移三组白名单路径会经本地后端转发到该地址。
KD_SERVER_URL=https://knowledgediver.cloud
KD_REMOTE_CONNECT_TIMEOUT=3
KD_REMOTE_READ_TIMEOUT=5
# 出站代理：默认**不使用**系统代理变量（ALL_PROXY/HTTPS_PROXY），云端一般可直连。
# 若确实需要代理才能访问云端，在这里显式指定；socks5 需先 pip install "httpx[socks]"
# KD_SERVER_PROXY=socks5://127.0.0.1:7897

# ── CORS ────────────────────────────────────────────────────────────────────
# 默认已是回环白名单；端口可变时由代码内的回环 regex 兜底。切勿改回 "*"。
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ── 嵌入模型 ────────────────────────────────────────────────────────────────
# 仓库不内置权重；建议按 README「快速开始」下载到 models/bge-small-zh-v1.5/ 以离线运行。
# 目录缺失时会回退到在线 HF 名称 BAAI/bge-small-zh-v1.5（首次使用需联网下载）。
# 国内网络可设置镜像：
# HF_ENDPOINT=https://hf-mirror.com

# ── 数据库 ──────────────────────────────────────────────────────────────────
# KNOWLEDGEDIVER_DB=data/knowledgediver.db

# ── 抓取 ────────────────────────────────────────────────────────────────────
# SCRAPER_TIMEOUT=10
